# Copy to .env and fill in. NEVER commit .env with real values.

# --- API ---
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed by CORS (frontend dev server by default)
API_CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
# Base URL the browser uses to reach the API. Must be reachable from the client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- PostgreSQL (not exposed publicly by default) ---
POSTGRES_USER=trading_lab
POSTGRES_PASSWORD=change_me_in_local_only
POSTGRES_DB=trading_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (not exposed publicly by default) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Limits (resource exhaustion / malicious upload protection) ---
API_MAX_UPLOAD_BYTES=52428800   # 50 MiB cap on raw CSV upload size
API_MAX_CANDLES=200000          # max rows per dataset
